# Next.js Environment Variables
# Copie este arquivo para .env.local e preencha com seus valores

# API Base URL (se necessário para integrações futuras)
NEXT_PUBLIC_API_URL=https://api.crai.com

# Analytics (opcional)
NEXT_PUBLIC_GA_ID=

# Modo de desenvolvimento
NODE_ENV=development

# Host do servidor
NEXT_PUBLIC_HOST=localhost:3000
